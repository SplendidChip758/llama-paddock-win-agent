<Project Sdk="Microsoft.NET.Sdk">

  <!-- The agent's tray app: runs in the user's session and does there what the service can't. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LlamaPaddock.Tray</RootNamespace>
    <AssemblyName>paddock-agent-tray</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>..\logo\paddock-agent.ico</ApplicationIcon>
    <!-- the release build sets the real one: dotnet publish -p:Version=1.2.3 -->
    <Version>0.0.0-dev</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- the tray icon, read at the size the screen's scaling asks for -->
  <ItemGroup>
    <EmbeddedResource Include="..\logo\paddock-agent.ico" LogicalName="paddock-agent.ico" />
  </ItemGroup>

  <!-- shared with the agent -->
  <ItemGroup>
    <Compile Include="..\agent\HelperPipe.cs" Link="Shared\HelperPipe.cs" />
    <Compile Include="..\agent\Launcher.cs" Link="Shared\Launcher.cs" />
    <Compile Include="..\agent\Native.cs" Link="Shared\Native.cs" />
    <Compile Include="..\agent\OllamaNames.cs" Link="Shared\OllamaNames.cs" />
  </ItemGroup>
</Project>
