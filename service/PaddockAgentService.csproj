<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Windows service in front of the Node agent. .NET Framework 4.8 is part of Windows 10
    and 11, so the exe needs nothing installed. Built in CI; opens in Visual Studio.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>paddock-agent-service</AssemblyName>
    <RootNamespace>LlamaPaddock.Agent</RootNamespace>
    <Version>0.0.0</Version>
    <Product>llama-paddock agent</Product>
    <Copyright>AGPL-3.0</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Management" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
